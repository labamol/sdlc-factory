# Factory runtime configuration
FACTORY_HOME=.
FACTORY_PROJECTS_DIR=projects
FACTORY_POLICIES_DIR=policies

# LLM runtime (optional; deterministic fallbacks are used when unset)
# needs the `llm` extra: pip install -e ".[llm]"
OPENAI_API_KEY=
FACTORY_MODEL=gpt-4o-mini
# set FACTORY_LLM=off to force deterministic reasoning even when a key is present
FACTORY_LLM=on
# OPENAI_BASE_URL=https://api.openai.com/v1

# PostgreSQL control/state store (Increment 3+; JSON file store is used when unset)
DATABASE_URL=

# GitHub forge (optional; the project-local PR registry is used when unset)
# token needs contents:write + pull-requests:write on the target repository
GITHUB_TOKEN=
FACTORY_TARGET_REPO=
FACTORY_TARGET_BRANCH=main
# set FACTORY_FORGE=off to keep PRs local even when a token is present
FACTORY_FORGE=on
# GITHUB_API_URL / GITHUB_GIT_URL point the adapter at GitHub Enterprise

# Jira tracker (optional; project-local tracker/issues.yaml is used when unset)
# all four values are required to activate the Jira adapter
JIRA_SITE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task
# set FACTORY_TRACKER=off to keep issues local even when Jira is configured
FACTORY_TRACKER=on

# Microsoft Teams notifications (optional; a local outbox is used when unset)
TEAMS_WEBHOOK_URL=
# set FACTORY_NOTIFY=off to keep notifications local even when a webhook is set
FACTORY_NOTIFY=on
